{
  "extends": "$app/tsconfig",
  "include": ["src", "*.ts"],
  "exclude": ["node_modules", ".svelte-kit/cloudflare"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["$app/types", "@cloudflare/workers-types"]
  }
}
