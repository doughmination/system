{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev --webpack",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --turbo",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "bun run build && opennextjs-cloudflare preview",
    "deploy": "bun run build && opennextjs-cloudflare deploy",
    "upload": "bun run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^2.1.1",
    "doughmination-api": "^1.6.0",
    "lucide-react": "1.54.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
